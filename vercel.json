{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/internal/maintenance",
      "schedule": "17 3 * * *"
    }
  ]
}
